#define SDF_LIBRARY_INCLUDED

// === 3D NOISE & FBM START === //
// 1. A pseudo-random hash generator
float hash(float3 p) 
{
    p = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

// 2. 3D Value Noise (Smoothes out the random hash into rolling hills)
float noise3D(float3 x) 
{
    float3 i = floor(x);
    float3 f = frac(x);
    f = f * f * (3.0 - 2.0 * f); // Smoothstep interpolation
    
    return lerp(lerp(lerp(hash(i + float3(0,0,0)), hash(i + float3(1,0,0)), f.x),
                     lerp(hash(i + float3(0,1,0)), hash(i + float3(1,1,0)), f.x), f.y),
                lerp(lerp(hash(i + float3(0,0,1)), hash(i + float3(1,0,1)), f.x),
                     lerp(hash(i + float3(0,1,1)), hash(i + float3(1,1,1)), f.x), f.y), f.z);
}

// 3. The exact equivalent of your C# FBM script
float fbm(float3 p, int octaves, float persistence) 
{
    float total = 0.0;
    float frequency = 1.0;
    float amplitude = 1.0;
    float maxValue = 0.0;
    
    for(int i = 0; i < octaves; i++) 
    {
        // Calculate noise, remap it from [0, 1] to [-1, 1], and accumulate
        total += (noise3D(p * frequency) * 2.0 - 1.0) * amplitude;
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= 2.0;
    }
    
    return total / maxValue;
}

// Rdige FBM function generated by Gemini
float ridgeFBM(float3 p, int octaves, float persistence) 
{
    float total = 0.0;
    float frequency = 1.0;
    float amplitude = 1.0;
    float maxValue = 0.0;
    
    for(int i = 0; i < octaves; i++) 
    {
        float n = noise3D(p * frequency);
        
        // 1. Turn the smooth noise wave into a sharp V-shaped valley
        n = abs(n * 2.0 - 1.0); 
        
        // 2. Invert it so the sharp points face upward (crests/ridges)
        n = 1.0 - n;            
        
        // 3. Square it to make the slopes steeper and the peaks sharper
        n = n * n;              
        
        total += n * amplitude;
        maxValue += amplitude;
        
        amplitude *= persistence;
        frequency *= 2.0;
    }
    
    return total / maxValue;
}
// === 3D NOISE & FBM END === //


// === MIN/MAX/ROT FUNCTIONS START === //
float sMin(float a, float b, float k)
{
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return lerp(b, a, h) - k * h * (1.0 - h);
}

float sMax(float a, float b, float k)
{
    float h = clamp(0.5 - 0.5 * (b - a) / k, 0.0, 1.0);
    return lerp(b, a, h) + k * h * (1.0 - h);
}

// Smooth minimum that also blends colors: It takes float4 instead of float. (x = distance, yzw = rgb color)
float4 sMinColor(float4 a, float4 b, float k)
{
    float h = clamp(0.5 + 0.5 * (b.x - a.x) / k, 0.0, 1.0);
    float minDist = lerp(b.x, a.x, h) - k * h * (1.0 - h);
    
    // Smoothly blend the colors using the exact same 'h' percentage
    float3 minCol = lerp(b.yzw, a.yzw, h);
    
    // Return the combined distance and color
    return float4(minDist, minCol);
}

// A standard minimum function for float4 (used for hard edges like the floor)
float4 minColor(float4 a, float4 b) 
{
    // If 'a' is closer than 'b', return 'a's data. Otherwise return 'b's data.
    return (a.x < b.x) ? a : b;
}

float2x2 Rot(float a) 
{
    float s = sin(a), c = cos(a);
    return float2x2(c, -s, s, c);
}
// === MIN/MAX FUNCTIONS END === //


// === BASIC DISTANCE FUNCTIONS START === //
float sdBox(float3 p, float3 b)
{
    float3 q = abs(p) - b;
    return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}

float sdCapsule(float3 p, float3 a, float3 b, float r)
{
    float3 ab = b-a;
    float3 ap = p-a;
    float t = dot(ab, ap) / dot(ab, ab);
    t = clamp(t, 0.0, 1.0);
    float3 c = a + t*ab;
    return length(p-c) - r;
}

float sdTorus(float3 p, float2 r)
{
    float x = length(p.xz) - r.x;
    return length(float2(x, p.y)) - r.y;
}

float sdCylinder(float3 p, float3 a, float3 b, float r)
{
    float3 ab = b-a;
    float3 ap = p-a;
    float t = dot(ab, ap) / dot(ab, ab);
    float3 c = a + t*ab;
    float x = length(p-c) - r;
    float y = (abs(t-0.5)-0.5) * length(ab);
    float e = length(max(float2(x,y),0.0));
    float i = min(max(x,y), 0.0);
    return e+i;
}

float sdCross(float3 p, float size)
{
    float infinity = 1000.0;

    // Create 3 pillars passing through the origin along XYZ axes
    float crossX = sdBox(p, float3(infinity, size, size));
    float crossY = sdBox(p, float3(size, infinity, size));
    float crossZ = sdBox(p, float3(size, size, infinity));

    return min(crossX, min(crossY, crossZ));
}
// === BASIC DISTANCE FUNCTIONS END === //


// === CUSTOM DISTANCE FUNCTIONS START === //
// Kaleidoscopic Iterated Function System Fractal
float sdKIFS(float3 p, float iterations, float time) 
{
    float scale = 1.0;
    
    // The Fractal Loop: Fold, Twist, and Scale
    for(int i = 0; i < iterations; i++) 
    {
        // 1. Fold space perfectly in half (this creates the repeating kaleidoscopic mirror)
        p = abs(p) - 1.0; 
        
        // 2. Twist the space on multiple axes
        p.xy = mul(Rot((time * 0.2) + sin(p.z)), p.xy);
        p.xz = mul(Rot((time * 0.15 + cos(p.y))), p.xz);
        
        // 3. Scale space up
        p *= 2.0; 
        
        // 4. Track the total accumulated scale!
        scale *= 2.0; 
    }
    
    
    float boxDist = sdBox(p, float3(1.0, 1.0, 1.0));

    float3 spherePos = p - float3(0 + sin(time * 2.0),2.5,0);
    float sphereDist = length(spherePos) - 1.7;
    
    float sceneDist = sMax(boxDist, -sphereDist, 1.4);
    
    // This is the "Distance Estimation (DE)" fix: 
    // We scale the distance back down so the raymarcher doesn't break.
    return sceneDist / scale; 
}

// Backrooms-esque Megastructure with Dune vibes
float sdMegaStructure(float3 p, float time)
{
    // Rotate the entire global world space on the XZ plane before anything else happens
    p.xz = mul(Rot(time * 0.01), p.xz);

    // === CONTROLS === //
    float upperThreshold = 15.0; // Height where structure is normal
    float lowerThreshold = -30.0; // Height where structure is fully mutated
    float mutationFactor = smoothstep(upperThreshold, lowerThreshold, p.y);

    // Horizontal repetition spacing (every 40 units on XZ)
    float2 spacingXZ = float2(40.0, 40.0);
    float2 idXZ = round(p.xz / spacingXZ);
    
    // Repeat space vertically every 16 units to define our floor levels
    float spacingY = 16.0;
    float idY = round(p.y / spacingY);

    // Generate a pseudo-random value between -1.0 and 1.0 unique to this floor ID (idY)
    float floorRand = frac(sin(idY * 123.456) * 43758.5453) * 2.0 - 1.0;
    float maxOffset = 3.7;
    float hallwayOffset = floorRand * maxOffset * mutationFactor;

    // Turning the doorway into a jesus cross as we go lower
    float vertHalfWidth = lerp(3.5, 0.45, mutationFactor);
    float vertHalfHeight = lerp(4.0, 2.5, mutationFactor);
    float vertCenterY = lerp(0.0, 1.2, mutationFactor); // Window floats up at the bottom

    float horizHalfWidth = lerp(0, 1.8, mutationFactor); // At the top, the cross is invisble. As we go lower, this cuts the wall
    float horizCenterY = 2.2;
    float horizHalfHeight = 0.45;
    
    
    // === 1. MACRO COLUMNS === //
    // Create local coordinates for this grid cell
    float3 q = p;
    q.xz = p.xz - spacingXZ * idXZ;
    
    float outerBox = sdBox(q, float3(16.0, 100000.0, 16.0)); // The Outer Mass: A massive pillar stretching vertically
    float innerBox = sdBox(q, float3(12.0, 100005.0, 12.0)); // The Inner Cutout: A slightly smaller box to hollow it out
    float structuralShell = sMax(outerBox, -innerBox, 2.0); // Hollow out the structure using smooth subtraction


    // === 2. MEZZO FLOORS AND CORRIDORS === //
    float localY = p.y - spacingY * idY;

    // Jesus Cross
    float corrX_Vert = sdBox(float3(q.x, localY - vertCenterY, q.z - hallwayOffset), float3(40.0, vertHalfHeight, vertHalfWidth));
    float corrX_Horiz = sdBox(float3(q.x, localY - horizCenterY, q.z - hallwayOffset), float3(40.0, horizHalfHeight, horizHalfWidth));
    float crossCorridorX = min(corrX_Vert, corrX_Horiz);

    float corrZ_Vert = sdBox(float3(q.x - hallwayOffset, localY - vertCenterY, q.z), float3(vertHalfWidth, vertHalfHeight, 40.0));
    float corrZ_Horiz = sdBox(float3(q.x - hallwayOffset, localY - horizCenterY, q.z), float3(horizHalfWidth, horizHalfHeight, 40.0));
    float crossCorridorZ = min(corrZ_Vert, corrZ_Horiz);

    float tunnelSystem = min(crossCorridorX, crossCorridorZ);
    float connectedStructure = sMax(structuralShell, -tunnelSystem, 0.5);
    
    
    // === 3. FLOORS === //
    float floor = sdBox(float3(q.x, localY+4.75, q.z), float3(14,.6,14));
    float floorCutout = sdBox(float3(q.x, localY+4.75, q.z), float3(4,1,4));
    float finalFloor = max(floor, -floorCutout);
    float structureWithFloors = min(connectedStructure, finalFloor);

    
    // === 4. HALLWAY FLOORS === //
    // Using abs() mirrors the space across the axis, giving us two bridges per box calculation
    float hallwaysX = sdBox(float3(abs(q.x) - 20.0, localY + 4.75, q.z), float3(6.0, 0.5, 4.0));
    float hallwaysY = sdBox(float3(q.x, localY + 4.75, abs(q.z) - 20.0), float3(4.0, 0.5, 6.0));
    float hallways = min(hallwaysX, hallwaysY);
    structureWithFloors = min(structureWithFloors, hallways);

    
    // === 5. NON-REPEATING MACRO DETAILS === //
    // DETAIL A: Vertical Support Structs
    // We fold space locally on the XZ acis to create four thick pillars in the corners of every room
    // We add noise to it so the lower you go, the weirder the columns get
    float structs = 100000.0;

    // Random seed unique to this floor
    float layoutRand = frac(sin(idY * 543.21) * 43758.5453);
    int layoutMode = 0; // Mode 0 = Standard 4 columns

    // Only allow layouts to mutate if we have descended into the mutation zone
    if (mutationFactor > 0.2)
    {
        if (layoutRand < 0.35) 
            layoutMode = 1; // 2 Columns
        else if (layoutRand > 0.7) 
            layoutMode = 2; // 6 Columns
    }

    // --- LAYOUT SWITCHING ---
    if (layoutMode == 0)
    {
        // Standard Symmetrical 4 Columns
        float3 pos = q;
        pos.xz = abs(pos.xz) - 9.5;
        structs = sdBox(float3(pos.x, localY, pos.z), float3(0.8, 18.0, 0.8));
    }
    else if (layoutMode == 1)
    {
        // Impossible 2 Columns (Only mirror X, push Z to the back wall)
        float3 pos = q;
        pos.x = abs(pos.x) - 9.5;
        pos.z = pos.z - 9.5; 
        structs = sdBox(float3(pos.x, localY, pos.z), float3(0.8, 18.0, 0.8));
    }
    else if (layoutMode == 2)
    {
        // Dense 6 Columns (4 corners + 2 center wall supports)
        float3 pos = q;
        pos.x = abs(pos.x) - 9.5; // Forms the two side rows
        
        // Draw the 4 standard corners
        float cornerPillars = sdBox(float3(pos.x, localY, abs(pos.z) - 9.5), float3(0.8, 18.0, 0.8));
        
        // Draw 2 extra pillars directly in the middle of the side walls (Z = 0)
        float centerPillars = sdBox(float3(pos.x, localY, pos.z), float3(0.8, 18.0, 0.8));
        
        // Combine them
        structs = min(cornerPillars, centerPillars);
    }

    float detailedStructure = min(structureWithFloors, structs);

    // DETAIL B: Horizontal Insets
    // frac() repeats space every 5 units vertically (*0.2), step() ensures the groove is a sharp, flat-bottomed trench rather than a wave
    // 85% of our wall is flat, and for the rest, we essentially say this spot is 0.2 units further away than you think
    float sharpGrooves = step(0.85, frac(p.y * 0.2)) * 0.2;
    detailedStructure += sharpGrooves;
    

    // === 7. SLENDER ALIEN CORE === //
    float3 corePos = q;
    corePos.xz = mul(Rot(time * 0.25), corePos.xz);
    float outerCore = sdBox(corePos, float3(0.4, 100000.0, 0.4));
    
    return min(detailedStructure, outerCore-0.1);
}

float4 sdMengerSponge(float3 p, float time)
{
    float3 spacing = float3(42,42,42);
    float3 id = round(p / spacing);
    p = p - spacing * id;
    
    float cubeHalfExt = 20.0;
    float spongeDist = sdBox(p, float3(cubeHalfExt,cubeHalfExt,cubeHalfExt));
    float scale = 1.0;
    
    for (int i = 0; i < 5; i++)
    {
        p = abs(p);

        // Calculate the cross in the current space
        float cross = sdCross(p, cubeHalfExt/3.0);
        spongeDist = sMax(spongeDist, -cross / scale, 0.05); // We divide by scale to keep our distance estimate math accurate

        // The step function returns true if we're in an outer zone, so we shift our center to here and punch a hole in the next iteration
        // If we're in the inner zone, then the coordinate doesn't shift because we already have a hole there
        p -= step(cubeHalfExt / 3.0, p) * (cubeHalfExt*2.0 / 3.0);
        p *= 3.0; // We scale space by 3 so the next iteration happens on another 3x3 grid
        scale *= 3.0;
    }
    
    float3 baseCol = float3(0.9, 0.88, 0.13);
    return float4(spongeDist, baseCol);
}

float4 sdMandelbulb(float3 p, float time)
{
    p.yz = mul(Rot(3.1415/2), p.yz);

    float3 z = p;
    float dr = 1.0; // Tracks the derivative (space expansion factor)
    float r = 0.0; // Tracks the current distance from the origin

    float power = 8.0; // The most famous power (shape) of the 3D Mandelbulb
    power += sin(time * 0.03) * 3.3;

    // Orbit Trap: Color the fractal based on how close it's orbital formula values got to whatever "trap" value we chose
    // For now, we are going for a simple plane-based orbit trap
    float3 trap = float3(10000.0, 10000.0, 10000.0); // This will keep track of the absolute closest approach to the center axes
    
    for (int i = 0; i < 14; i++)
    {
        r = length(z);
        
        // Early break: If our point is past a radius of 2, we can break early because this will always result in the value going to infinity
        if (r > 2.0) break;

        // Plane Orbit Trap: Measure the abs distance to the center planes
        // Since we are folding space continously, tracking abs(z) captures the underlying geometric seams of the fractal cuts
        trap = min(trap, abs(z));

        // 1. Convert cartesian (XYZ) to Polar/Spherical angles
        float theta = acos(z.y / r);
        float phi = atan2(z.x, z.z);

        // 2. Track the derivative (running scale factor)
        // Formula: dr = (r^(power-1) * power * dr) + 1.0
        dr = pow(r, power-1.0) * power * dr + 1.0;

        // 3. Amplify the distance and scale up the angles
        float zr = pow(r, power);
        theta *= power;
        phi *= power;

        // 4. Convert back to cartesian, and add the original point 'p'
        z = zr * float3(sin(theta) * sin(phi), cos(theta), sin(theta) * cos(phi));
        z += p;
    }

    // Inigo Quilez's Distance Estimator
    float distanceEstimation = 0.5 * log(r) * r / dr;

    // Orbit Trap Palette (Annihilation based)
    float3 baseDarkness = float3(0.08, 0.08, 0.1);  // Dark base
    float3 neonGreen = float3(0.12, 1.85, 0.45);    // X-axis folds
    float3 magentaPink = float3(1.85, 0.15, 0.70);  // Y-axis folds
    float3 electricCyan = float3(0.10, 0.55, 1.95); // Z-axis folds

    // We invert the trap value so numbers close to 0 become 1
    // Raising it to a high power pinches the mask it only highlights thin, creviced borders instead of spilling everywhere
    float3 masks = pow(saturate(1.0 - trap), 8.0);

    // Layering the colors based on the axis
    float3 finalCol = baseDarkness;
    finalCol = lerp(finalCol, neonGreen, masks.x);
    finalCol = lerp(finalCol, magentaPink, masks.y);
    finalCol = lerp(finalCol, electricCyan, masks.z);

    // Return the distance and the orbit trapped colour
    return float4(distanceEstimation, finalCol);
}
// === CUSTOM DISTANCE FUNCTIONS END === //

